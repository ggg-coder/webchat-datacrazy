# ─────────────────────────────────────────────────────────────────────────────
# Webchat DataCrazy — variáveis de ambiente
#
# Na Vercel, cadastre em Settings → Environment Variables.
# Para rodar localmente, copie este arquivo para .env.local.
#
# Tudo o mais (API key do DataCrazy, URLs de webhook, aparência, domínios)
# é configurado pelo painel /admin e fica salvo no banco.
# ─────────────────────────────────────────────────────────────────────────────

# O login do painel /admin usa o Supabase Auth: crie os usuários em
# Supabase → Authentication → Users e desative "Allow new users to sign up".

# Texto aleatório com 32 caracteres ou mais. Assina cookies e tokens e criptografa
# a API key do DataCrazy no banco. Se trocar, a API key precisa ser cadastrada de novo.
# Para gerar: openssl rand -base64 32
APP_SECRET=

# ── Supabase ─────────────────────────────────────────────────────────────────
# Se você criou o banco pela integração Supabase da Vercel, estas variáveis já
# foram criadas automaticamente. Caso contrário, copie de
# Supabase → Project Settings → API (e → Database para a connection string).

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: conexão direta com o Postgres. Com ela o painel cria as tabelas sozinho
# (botão "Criar tabelas"); sem ela, cole supabase/migrations/*.sql no SQL Editor.
POSTGRES_URL_NON_POOLING=

# Opcional: protege a rota /api/cron/retry. A Vercel envia automaticamente
# "Authorization: Bearer $CRON_SECRET" nas execuções agendadas.
CRON_SECRET=

# Só para desenvolvimento (ex.: túnel): endereço público deste app.
# Na Vercel não precisa: o domínio de produção é detectado sozinho.
APP_URL=
